# =============================================================================
# AI Doc Analysis - Environment Configuration
# =============================================================================
# Copy this file to .env and edit values for your environment.
# =============================================================================

# ---- PostgreSQL Database ----
DB_HOST=postgres-18
DB_PORT=5432
DB_NAME=docqa
DB_USER=docqa
DB_PASSWORD=your_secure_password_here

# ---- Ollama LLM ----
# Docker Desktop (Mac/Windows): http://host.docker.internal:11434
# Linux with host network:       http://localhost:11434
# Linux with bridge network:     http://192.168.x.x:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=llama3.2-vision

# ---- Embeddings (Multilingual: Arabic + English + 50 languages) ----
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# ---- Offline Mode (for air-gapped deployment) ----
HF_MODELS_OFFLINE=false
HF_MODELS_PATH=/app/models

# ---- Tesseract OCR ----
# Languages: eng (English), ara (Arabic), fra (French), etc.
# Leave TESSERACT_CMD empty to auto-detect
TESSERACT_CMD=
TESSERACT_LANGS=eng+ara

# ---- Document Processing ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=18
UPLOAD_DIR=./data/uploads

# ---- Timeouts (seconds) ----
OLLAMA_TIMEOUT=1200

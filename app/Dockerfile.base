# =============================================================================
# Dockerfile.base - Base image for RagDoc App (offline-capable)
# =============================================================================
# Multi-stage build with Tesseract OCR (eng+ara) and all Python packages.
#
# Build ONCE while online (after running download_wheels.bat/sh):
#   cd app
#   docker build -f Dockerfile.base -t ragdoc-app-base:latest .
# =============================================================================

# --- Stage 1: Install packages from wheels + online fallback ---
FROM python:3.12-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc g++ \
    && rm -rf /var/lib/apt/lists/*

COPY packages/ /opt/wheels/

# Install from local wheels first, then online for any missing packages
RUN pip install --no-cache-dir --find-links=/opt/wheels/ \
    -r /opt/wheels/requirements.txt

# --- Stage 2: Final clean image (no wheels) ---
FROM python:3.12-slim

LABEL maintainer="RagDoc"
LABEL description="Base image for RagDoc App with Tesseract OCR (eng+ara) and offline Python packages"

# Runtime dependencies + Tesseract OCR with Arabic and English
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    poppler-utils \
    libmagic1 \
    curl \
    # Tesseract OCR with language packs
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-ara \
    # OpenCV dependencies (libgl1 replaces libgl1-mesa-glx in Debian Trixie+)
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages/ /usr/local/lib/python3.12/site-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/

# Verify critical packages
RUN python -c "import torch; print(f'torch {torch.__version__}')" \
    && python -c "import fastapi; print(f'fastapi {fastapi.__version__}')" \
    && python -c "import langchain; print(f'langchain {langchain.__version__}')" \
    && python -c "import transformers; print(f'transformers {transformers.__version__}')" \
    && python -c "import cv2; print(f'opencv {cv2.__version__}')" \
    && tesseract --version | head -1

# Verify Tesseract languages
RUN tesseract --list-langs
